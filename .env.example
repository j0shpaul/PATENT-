# ==============================================================================
# PATENT+ Environment Configuration Template
# ==============================================================================

# Runtime Environment (development | production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Backend & Database Configuration
# ------------------------------------------------------------------------------
# Production: PostgreSQL connection string (MANDATORY in production)
# Example: postgresql://user:password@cloud-db-host.com:5432/patent_plus
DATABASE_URL=sqlite:///./patent_plus.db

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated origins allowed to access the API)
# Example: https://staging.rocketride.ai,https://app.rocketride.ai,https://your-custom-domain.com
CORS_ORIGINS=https://staging.rocketride.ai,https://app.rocketride.ai

# ------------------------------------------------------------------------------
# Frontend Build-Time Configuration
# ------------------------------------------------------------------------------
# Injected at build time into the React micro-frontend bundle
# Example: https://api.patentplus.yourdomain.com/api
VITE_API_URL=

# ------------------------------------------------------------------------------
# External Patent Office & AI Provider APIs (Optional)
# ------------------------------------------------------------------------------
# Enables Claude 3.5 Sonnet (falls back to deterministic local legal AI engine if unset)
ANTHROPIC_API_KEY=

# Enables live USPTO Open Data Portal queries (falls back to verified real cache if unset)
USPTO_API_KEY=

# Enables live EPO Open Patent Services queries (falls back to verified real cache if unset)
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

