# ==============================================================================
# PATENT+ Environment Configuration Template
# ==============================================================================

# Runtime Environment (development | production)
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Backend & Database Configuration
# ------------------------------------------------------------------------------
# Production: PostgreSQL connection string (MANDATORY in production)
# Example: postgresql://user:password@cloud-db-host.com:5432/patent_plus
DATABASE_URL=sqlite:///./patent_plus.db

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated origins allowed to access the API)
# Example: https://staging.rocketride.ai,https://app.rocketride.ai,https://your-custom-domain.com
CORS_ORIGINS=https://staging.rocketride.ai,https://app.rocketride.ai

# ------------------------------------------------------------------------------
# Frontend Build-Time Configuration
# ------------------------------------------------------------------------------
# Injected at build time into the React micro-frontend bundle
# Example: https://api.patentplus.yourdomain.com/api
VITE_API_URL=

# ------------------------------------------------------------------------------
# AI & LLM Model Providers (Free & Open Models Supported)
# ------------------------------------------------------------------------------
# Provider mode: "auto" | "gemini" | "openrouter" | "openai" | "anthropic" | "ollama" | "local"
AI_PROVIDER=auto

# Option A: Google Gemini API (Recommended Free/Fast LLM)
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option B: OpenRouter Free Models (Open Models)
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models: google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free,
#              nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Option B: OpenAI or OpenAI-Compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option C: Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option D: Local Ollama (Zero Cost, Fully Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------------------------------------------
# External Patent Office APIs (Optional)
# ------------------------------------------------------------------------------
# Enables live USPTO Open Data Portal queries (falls back to verified real cache if unset)
USPTO_API_KEY=

# Enables live EPO Open Patent Services queries (falls back to verified real cache if unset)
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=


